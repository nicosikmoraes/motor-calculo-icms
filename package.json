{
  "name": "contabilinico",
  "version": "0.1.2",
  "private": true,
  "description": "ContabiliNico — aplicativo desktop local-first para cálculo e auditoria fiscal.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @motor/desktop dev",
    "build": "pnpm --filter @motor/api build && pnpm --filter @motor/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:tooling && pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:api": "pnpm --filter @motor/api start:dev",
    "start:api": "pnpm --filter @motor/api start:prod",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "test:api": "pnpm --filter @motor/api test",
    "test:db": "pnpm --filter @motor/api test:db",
    "lint": "pnpm --filter @motor/api lint",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:validate": "pnpm --filter @motor/api prisma:validate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
