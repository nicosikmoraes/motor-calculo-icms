{
  "name": "motor-calculo-icms",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo desktop local-first para cálculo e auditoria de ICMS.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @motor/desktop dev",
    "build": "pnpm --filter @motor/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
