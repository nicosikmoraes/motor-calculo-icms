{
  "name": "@motor/desktop",
  "productName": "ContabiliNico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@motor/contracts": "workspace:*",
    "@motor/database": "workspace:*",
    "@motor/domain": "workspace:*",
    "@motor/interchange": "workspace:*",
    "@motor/nfe-parser": "workspace:*",
    "@motor/reporting": "workspace:*",
    "@motor/tax-engine": "workspace:*",
    "exceljs": "4.4.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "electron-builder": "26.0.12",
    "electron-vite": "^4.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "appId": "br.com.contabilinico.desktop",
    "productName": "ContabiliNico",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ContabiliNico-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    }
  }
}
